---
interface Props {
  tone?: "tint" | "solid" | "rose-tint" | "rose-solid";
  uppercase?: boolean;
  href?: string;
  external?: boolean;
  class?: string;
}

const { tone = "tint", uppercase = false, href, external = false, class: className } = Astro.props;

const toneClasses: Record<NonNullable<Props["tone"]>, string> = {
  tint: "bg-slate-blue/10 text-slate-blue",
  solid: "bg-slate-blue text-white",
  "rose-tint": "bg-rose/10 text-rose",
  "rose-solid": "bg-rose text-white",
};

const hoverClasses: Record<NonNullable<Props["tone"]>, string> = {
  tint: "hover:bg-slate-blue/20",
  solid: "hover:bg-slate-blue/90",
  "rose-tint": "hover:bg-rose/20",
  "rose-solid": "hover:bg-rose/90",
};

const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  target={href && external ? "_blank" : undefined}
  rel={href && external ? "noopener noreferrer" : undefined}
  class:list={[
    "rounded-full font-medium",
    uppercase ? "px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide" : "px-3 py-1 text-xs",
    toneClasses[tone],
    href && ["transition-colors", hoverClasses[tone]],
    className,
  ]}
>
  <slot />
</Tag>
