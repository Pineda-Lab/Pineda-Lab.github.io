---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-slate-200/70 bg-white">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-widest text-ice">{eyebrow}</p>}
    <h1 class="mt-2 text-balance text-4xl font-bold tracking-tight text-navy sm:text-5xl">{title}</h1>
    {description && <p class="mt-4 max-w-2xl text-lg text-slate-600">{description}</p>}
  </div>
</section>
