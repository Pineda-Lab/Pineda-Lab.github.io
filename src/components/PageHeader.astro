---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-slate-200/70 bg-surface">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--color-ice)_0%,_transparent_60%)] opacity-20"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-20">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h1 class="mt-2 text-balance text-4xl font-bold tracking-tight text-navy sm:text-5xl">{title}</h1>
    {description && <p class="mt-4 max-w-2xl text-lg text-slate-600">{description}</p>}
  </div>
</section>
