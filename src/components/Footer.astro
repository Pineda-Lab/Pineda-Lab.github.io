---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import LogoWatermark from "./LogoWatermark.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
const homeHref = getRelativeLocaleUrl(locale, "/");

const navLinks = [
  { href: getRelativeLocaleUrl(locale, "/"), label: t.nav.home },
  { href: getRelativeLocaleUrl(locale, "/people"), label: t.nav.people },
  { href: `${homeHref}#projects`, label: t.nav.projects },
  { href: getRelativeLocaleUrl(locale, "/teaching"), label: t.nav.teaching },
  { href: getRelativeLocaleUrl(locale, "/publications"), label: t.nav.publications },
];

const links = [
  { href: "https://github.com/Pineda-Lab", label: "GitHub", external: true, icon: true },
  { href: getRelativeLocaleUrl(locale, "/privacy"), label: t.footer.privacyLabel, external: false, icon: false },
  { href: getRelativeLocaleUrl(locale, "/terms"), label: t.footer.termsLabel, external: false, icon: false },
];
---

<footer class="relative overflow-hidden border-t border-slate-200/70 bg-gradient-to-r from-navy to-slate-blue text-slate-300">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_left,_var(--color-ice)_0%,_transparent_45%)] opacity-20"></div>
  <LogoWatermark class="-right-10 top-1/2 h-40 w-40 -translate-y-1/2 sm:h-48 sm:w-48" />
  <div class="relative mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-6 sm:flex-row sm:justify-between">
    <a href={homeHref} class="flex items-center gap-2.5 text-white">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white p-1">
        <Logo class="h-full w-full" />
      </div>
      <span class="font-semibold tracking-tight">{t.meta.siteName}</span>
    </a>

    <div class="flex flex-col items-center gap-2 sm:items-end">
      <nav aria-label={t.nav.footerNavLabel} class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-slate-400 sm:justify-end">
        {
          navLinks.map((link) => (
            <a href={link.href} class="inline-flex items-center gap-1.5 transition-colors hover:text-ice">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-slate-400 sm:justify-end">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="inline-flex items-center gap-1.5 transition-colors hover:text-ice"
            >
              {link.icon && (
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
              )}
              {link.label}
            </a>
          ))
        }
        <span class="text-slate-500">
          &copy; {year} {t.meta.siteName}. {t.footer.rights}
        </span>
      </div>
    </div>
  </div>
</footer>
