---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
const homeHref = getRelativeLocaleUrl(locale, "/");

const links = [
  { href: "https://github.com/Pineda-Lab", label: "GitHub", external: true },
  { href: getRelativeLocaleUrl(locale, "/privacy"), label: t.footer.privacyLabel, external: false },
  { href: getRelativeLocaleUrl(locale, "/terms"), label: t.footer.termsLabel, external: false },
];
---

<footer class="border-t border-slate-200/70 bg-navy text-slate-300">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-6 text-sm sm:flex-row sm:justify-between">
    <a href={homeHref} class="flex items-center gap-2.5 text-white">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white p-1">
        <Logo class="h-full w-full" />
      </div>
      <span class="font-semibold tracking-tight">{t.meta.siteName}</span>
    </a>

    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-slate-400">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="transition-colors hover:text-ice"
          >
            {link.label}
          </a>
        ))
      }
      <span class="text-slate-500">
        &copy; {year} {t.meta.siteName}. {t.footer.rights}
      </span>
    </div>
  </div>
</footer>
