---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const links = [
    { href: "https://www.unam.mx", label: "UNAM" },
    { href: "https://www.enesmorelia.unam.mx", label: "ENES Morelia" },
    { href: "https://github.com/Pineda-Lab", label: "GitHub" },
];

const email = "arturolp@enesmorelia.unam.mx";

const legalLinks = [
    {
        href: getRelativeLocaleUrl(locale, "/privacy"),
        label: t.footer.privacyLabel,
    },
    {
        href: getRelativeLocaleUrl(locale, "/terms"),
        label: t.footer.termsLabel,
    },
];
---

<footer class="border-t border-slate-200/70 bg-navy text-slate-300">
    <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid gap-10 md:grid-cols-3">
            <div>
                <div class="flex items-center gap-3 text-white">
                    <Logo class="h-8 w-8 text-ice" />
                    <span class="text-base font-semibold"
                        >{t.meta.siteName}</span
                    >
                </div>
                <p class="mt-3 max-w-xs text-sm text-slate-400">
                    {t.footer.description}
                </p>
            </div>

            <div>
                <h3
                    class="text-sm font-semibold uppercase tracking-wide text-slate-100"
                >
                    {t.footer.linksHeading}
                </h3>
                <ul class="mt-3 space-y-2 text-sm">
                    {
                        links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-slate-400 transition-colors hover:text-ice"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                <h3
                    class="text-sm font-semibold uppercase tracking-wide text-slate-100"
                >
                    {t.footer.contactHeading}
                </h3>
                <ul class="mt-3 space-y-2 text-sm text-slate-400">
                    <li>
                        <a
                            href={`mailto:${email}`}
                            class="transition-colors hover:text-ice"
                        >
                            {email}
                        </a>
                    </li>
                    <li>Morelia, Michoacán, México</li>
                </ul>
            </div>
        </div>

        <div
            class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
        >
            <p>&copy; {year} {t.meta.siteName}. {t.footer.rights}.</p>
            <ul class="flex gap-4">
                {
                    legalLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="transition-colors hover:text-ice"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</footer>
