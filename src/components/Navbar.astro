---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import { getLocale, useTranslations, locales } from "../i18n/utils";
import { getProjects } from "../utils/projects";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const basePath = Astro.url.pathname.replace(/^\/es(\/|$)/, "/");

const homeHref = getRelativeLocaleUrl(locale, "/");

const projectOptions = getProjects(locale).map((project) => ({
  slug: project.slug,
  name: project.name,
  href: getRelativeLocaleUrl(locale, `/${project.slug}`),
}));
const projectPaths = projectOptions.map((project) => `/${project.slug}`);

// Projects has no listing page and no "all projects" link — the nav entry is
// just a dropdown trigger (desktop) / non-link label (mobile) over the
// individual project links. Each project's own page is a clean top-level URL
// (/diabetia, not /projects/diabetia), so its active state is matched
// against projectPaths rather than a path prefix.
const navItems = [
  { path: "/", label: t.nav.home },
  { path: "/people", label: t.nav.people },
  { path: "/projects", label: t.nav.projects, dropdown: true, matchPaths: projectPaths },
  { path: "/teaching", label: t.nav.teaching },
  { path: "/publications", label: t.nav.publications },
];

const navLinks = navItems.map((item) => ({
  href: item.href ?? getRelativeLocaleUrl(locale, item.path),
  label: item.label,
  active: item.matchPaths
    ? item.matchPaths.includes(basePath)
    : item.path === "/"
      ? basePath === "/"
      : basePath.startsWith(item.path),
  dropdown: item.dropdown ?? false,
}));

const localeLabels = { en: t.nav.langEnglish, es: t.nav.langSpanish };
const localeOptions = locales.map((loc) => ({
  code: loc,
  href: getRelativeLocaleUrl(loc, basePath),
  label: localeLabels[loc],
  active: loc === locale,
}));
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-surface/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label={t.nav.mainNavLabel}>
    <a href={homeHref} class="flex items-center gap-3 text-navy">
      <Logo class="h-11 w-11 shrink-0" />
      <span class="text-lg font-bold tracking-tight">{t.meta.siteName}</span>
    </a>

    <div class="hidden items-center gap-2 md:flex">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) =>
            link.dropdown ? (
              <li class="relative">
                <button
                  id="projects-toggle"
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="projects-menu"
                  class:list={[
                    "inline-flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition-colors",
                    link.active
                      ? "bg-slate-blue text-white"
                      : "text-navy/80 hover:bg-slate-blue/10 hover:text-slate-blue",
                  ]}
                >
                  {link.label}
                  <svg id="projects-chevron" class="h-3 w-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div
                  id="projects-menu"
                  role="menu"
                  class="invisible absolute left-0 top-full mt-2 w-48 origin-top-left scale-95 rounded-xl border border-slate-200 bg-white py-1 opacity-0 shadow-lg transition-all"
                >
                  {
                    projectOptions.map((project) => (
                      <a href={project.href} role="menuitem" class="block px-3 py-2 text-sm text-navy/80 hover:bg-slate-blue/5">
                        {project.name}
                      </a>
                    ))
                  }
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={link.href}
                  aria-current={link.active ? "page" : undefined}
                  class:list={[
                    "rounded-full px-4 py-2 text-sm font-medium transition-colors",
                    link.active
                      ? "bg-slate-blue text-white"
                      : "text-navy/80 hover:bg-slate-blue/10 hover:text-slate-blue",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="relative ml-2">
        <button
          id="lang-toggle"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-full border border-slate-blue px-3 py-2 text-sm font-medium text-slate-blue transition-colors hover:bg-slate-blue hover:text-white"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label={t.nav.langSwitchLabel}
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3c2.5 2.7 3.8 6 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-6-3.8-9s1.3-6.3 3.8-9z" />
          </svg>
          <span>{locale.toUpperCase()}</span>
          <svg id="lang-chevron" class="h-3 w-3 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div
          id="lang-menu"
          role="menu"
          class="invisible absolute right-0 top-full mt-2 w-40 origin-top-right scale-95 rounded-xl border border-slate-200 bg-white py-1 opacity-0 shadow-lg transition-all"
        >
          {
            localeOptions.map((option) => (
              <a
                href={option.href}
                role="menuitem"
                hreflang={option.code}
                lang={option.code}
                aria-current={option.active ? "true" : undefined}
                class:list={[
                  "flex items-center justify-between gap-2 px-3 py-2 text-sm transition-colors",
                  option.active ? "font-semibold text-slate-blue" : "text-navy/80 hover:bg-slate-blue/5",
                ]}
              >
                {option.label}
                {option.active && (
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-navy md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.nav.toggleMenu}
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-200/70 bg-surface md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            {link.dropdown ? (
              <p
                class:list={[
                  "block rounded-md px-3 py-2 text-base font-medium",
                  link.active ? "bg-slate-blue text-white" : "text-navy/80",
                ]}
              >
                {link.label}
              </p>
            ) : (
              <a
                href={link.href}
                aria-current={link.active ? "page" : undefined}
                class:list={[
                  "block rounded-md px-3 py-2 text-base font-medium",
                  link.active
                    ? "bg-slate-blue text-white"
                    : "text-navy/80 hover:bg-slate-blue/10 hover:text-slate-blue",
                ]}
              >
                {link.label}
              </a>
            )}
            {link.dropdown && (
              <ul class="mt-1 space-y-1 pl-4">
                {projectOptions.map((project) => (
                  <li>
                    <a
                      href={project.href}
                      class="block rounded-md px-3 py-2 text-sm text-navy/70 hover:bg-slate-blue/10 hover:text-slate-blue"
                    >
                      {project.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li class="mt-2 flex items-center justify-end gap-2 border-t border-slate-200/70 pt-3">
        <svg class="h-4 w-4 shrink-0 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c2.5 2.7 3.8 6 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-6-3.8-9s1.3-6.3 3.8-9z" />
        </svg>
        <div role="group" aria-label={t.nav.langSwitchLabel} class="flex gap-1.5">
          {
            localeOptions.map((option) =>
              option.active ? (
                <span
                  lang={option.code}
                  aria-current="true"
                  class="rounded-full bg-slate-blue px-3.5 py-1.5 text-xs font-semibold text-white"
                >
                  {option.code.toUpperCase()}
                </span>
              ) : (
                <a
                  href={option.href}
                  hreflang={option.code}
                  lang={option.code}
                  aria-label={option.label}
                  class="rounded-full border border-slate-blue/40 px-3.5 py-1.5 text-xs font-semibold text-slate-blue transition-colors hover:bg-slate-blue/10"
                >
                  {option.code.toUpperCase()}
                </a>
              ),
            )
          }
        </div>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isHidden)));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  function setupDropdown(toggleId: string, menuId: string, chevronId: string) {
    const toggle = document.getElementById(toggleId);
    const dropdownMenu = document.getElementById(menuId);
    const chevron = document.getElementById(chevronId);

    function close() {
      dropdownMenu?.classList.add("invisible", "opacity-0", "scale-95");
      chevron?.classList.remove("rotate-180");
      toggle?.setAttribute("aria-expanded", "false");
    }

    function open() {
      dropdownMenu?.classList.remove("invisible", "opacity-0", "scale-95");
      chevron?.classList.add("rotate-180");
      toggle?.setAttribute("aria-expanded", "true");
    }

    toggle?.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? close() : open();
    });

    document.addEventListener("click", (event) => {
      if (!dropdownMenu || !toggle) return;
      if (dropdownMenu.contains(event.target as Node) || toggle.contains(event.target as Node)) return;
      close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  }

  setupDropdown("lang-toggle", "lang-menu", "lang-chevron");
  setupDropdown("projects-toggle", "projects-menu", "projects-chevron");
</script>
