---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const otherLocale = locale === "en" ? "es" : "en";

const basePath = Astro.url.pathname.replace(/^\/es(\/|$)/, "/");

const navItems = [
  { path: "/", label: t.nav.home },
  { path: "/people", label: t.nav.people },
  { path: "/teaching", label: t.nav.teaching },
  { path: "/publications", label: t.nav.publications },
];

const navLinks = navItems.map((item) => ({
  href: getRelativeLocaleUrl(locale, item.path),
  label: item.label,
  active: item.path === "/" ? basePath === "/" : basePath.startsWith(item.path),
}));

const homeHref = getRelativeLocaleUrl(locale, "/");
const otherLocaleHref = getRelativeLocaleUrl(otherLocale, basePath);
const otherLocaleLabel = otherLocale.toUpperCase();
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-surface/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label={t.nav.mainNavLabel}>
    <a href={homeHref} class="flex items-center gap-3 text-navy">
      <Logo class="h-11 w-11 shrink-0" />
      <span class="text-lg font-bold tracking-tight">{t.meta.siteName}</span>
    </a>

    <div class="hidden items-center gap-2 md:flex">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.active ? "page" : undefined}
                class:list={[
                  "rounded-full px-4 py-2 text-sm font-medium transition-colors",
                  link.active
                    ? "bg-slate-blue text-white"
                    : "text-navy/80 hover:bg-slate-blue/10 hover:text-slate-blue",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={otherLocaleHref}
        aria-label={t.nav.langSwitchLabel}
        class="ml-2 rounded-full border border-slate-blue px-3 py-2 text-sm font-medium text-slate-blue transition-colors hover:bg-slate-blue hover:text-white"
      >
        {otherLocaleLabel}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-navy md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.nav.toggleMenu}
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-200/70 bg-surface md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.active ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2 text-base font-medium",
                link.active
                  ? "bg-slate-blue text-white"
                  : "text-navy/80 hover:bg-slate-blue/10 hover:text-slate-blue",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={otherLocaleHref}
          class="block rounded-md border border-slate-blue px-3 py-2 text-center text-base font-medium text-slate-blue"
        >
          {otherLocaleLabel}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isHidden)));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
