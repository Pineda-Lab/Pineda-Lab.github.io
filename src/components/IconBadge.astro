---
interface Props {
  href: string;
  external?: boolean;
}

const { href, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm font-medium text-slate-blue transition-colors hover:border-slate-blue/40 hover:bg-slate-blue/5"
>
  <slot />
</a>
