---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
import { getLocale, useTranslations } from "../i18n/utils";
import { parseTerm, isCurrentTerm, sortTermsDescending, courseTermSlug } from "../utils/academicTerm";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout title={t.teaching.title} description={t.teaching.description}>
  <PageHeader eyebrow={t.teaching.eyebrow} title={t.teaching.title} description={t.teaching.description} />

  <section class="mx-auto max-w-6xl space-y-12 px-6 py-16 sm:py-20">
    {
      t.teaching.programs.map((program) => (
        <div>
          <h2 class="text-xl font-bold text-navy">{program.name}</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {program.courses.map((course) => (
              <Card>
                <h3 class="font-semibold text-navy">{course.name}</h3>
                <div class="mt-3 flex flex-wrap gap-2">
                  {sortTermsDescending(course.terms).map((term) => {
                    const { season, year } = parseTerm(term);
                    const seasonLabel = season === "fall" ? t.teaching.fallLabel : t.teaching.springLabel;
                    const current = isCurrentTerm(term);
                    return (
                      <a
                        href={getRelativeLocaleUrl(locale, `/teaching/${courseTermSlug(course.slug, term)}`)}
                        class:list={[
                          "flex flex-col items-start gap-0.5 rounded-xl px-3 py-1.5 leading-tight transition-opacity hover:opacity-80",
                          current ? "bg-rose text-white" : "bg-slate-blue/10 text-slate-blue",
                        ]}
                      >
                        <span class="text-sm font-semibold">
                          {seasonLabel} {year}
                        </span>
                        <span class="text-[11px] font-normal opacity-70">{term}</span>
                      </a>
                    );
                  })}
                </div>
              </Card>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Layout>
