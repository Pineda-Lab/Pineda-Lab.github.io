---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout title={t.teaching.title} description={t.teaching.description}>
  <PageHeader eyebrow={t.teaching.eyebrow} title={t.teaching.title} description={t.teaching.description} />

  {
    t.teaching.programs.map((program) => (
      <section class="mx-auto max-w-6xl px-6 py-12">
        <h2 class="text-xl font-bold text-navy">{program.name}</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {program.courses.map((course) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <h3 class="font-semibold text-navy">{course.name}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {course.terms.map((term) => (
                  <span class="rounded-full bg-slate-blue/10 px-3 py-1 text-xs font-medium text-slate-blue">{term}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
