---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import LegalDocument from "../components/LegalDocument.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout title={t.legal.privacy.title} description={t.legal.privacy.paragraphs[0]} noindex>
  <PageHeader title={t.legal.privacy.title} />

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <LegalDocument paragraphs={t.legal.privacy.paragraphs} />
  </section>
</Layout>
