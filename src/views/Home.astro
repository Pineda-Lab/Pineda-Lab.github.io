---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import IconBadge from "../components/IconBadge.astro";
import LogoWatermark from "../components/LogoWatermark.astro";
import { getLocale, useTranslations } from "../i18n/utils";
import { getInitials } from "../utils/initials";
import { getProjects } from "../utils/projects";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const projects = getProjects(locale);

const peopleHref = getRelativeLocaleUrl(locale, "/people");
const addressLines = [
  "ENES Morelia, UNAM",
  "Antigua Carretera a Pátzcuaro No. 8701",
  "Ex Hacienda de San José de la Huerta",
  "58190 Morelia, Michoacán, México",
];
const mapsQuery = encodeURIComponent(addressLines.join(", "));
---

<Layout title={t.home.title} description={t.meta.defaultDescription}>
  <section class="relative overflow-hidden bg-gradient-to-br from-navy via-slate-blue to-ice text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_white_0%,_transparent_45%)] opacity-10"></div>
    <LogoWatermark class="-right-16 -top-24 h-72 w-72 sm:h-96 sm:w-96" />
    <div class="relative mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="grid gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="max-w-3xl">
          <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
            {t.home.title}
          </h1>
          <p class="mt-2 text-lg font-medium text-ice sm:text-xl">
            {t.home.subtitle}
          </p>
          <p class="mt-6 max-w-2xl text-balance text-lg leading-relaxed text-slate-300">
            {t.home.intro}
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <Button href={peopleHref}>{t.home.ctaPrimary}</Button>
          </div>
        </div>

        <div class="relative mb-8 lg:mb-0">
          <div class="overflow-hidden rounded-3xl border border-white/10 shadow-xl">
            <img
              src="/images/campus/enes-morelia.jpg"
              alt={t.home.campusPhotoAlt}
              width="1200"
              height="900"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
          <div class="absolute -bottom-8 -left-8 rounded-2xl bg-white p-4 shadow-lg">
            <img
              src="/images/logos/logo-enes-morelia.png"
              alt="ENES Morelia"
              width="360"
              height="222"
              class="h-16 w-auto sm:h-20"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="max-w-2xl">
      <Eyebrow>{t.home.pillarsEyebrow}</Eyebrow>
      <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight text-navy sm:text-4xl">
        {t.home.pillarsTitle}
      </h2>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.home.pillars.map((pillar) => (
          <FeatureCard icon={pillar.icon as "brain" | "device" | "dna"} title={pillar.title} description={pillar.description} />
        ))
      }
    </div>
  </section>

  <section id="projects" class="scroll-mt-20 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="max-w-2xl">
        <Eyebrow>{t.projects.eyebrow}</Eyebrow>
        <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight text-navy sm:text-4xl">
          {t.projects.title}
        </h2>
        <p class="mt-3 text-slate-600">{t.projects.description}</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          projects.map((project) => (
            <a href={getRelativeLocaleUrl(locale, `/${project.slug}`)} class="group block">
              <Card class="flex h-full items-start gap-4 transition-all hover:-translate-y-1 hover:border-slate-blue/40 hover:shadow-md">
                {
                  project.logo ? (
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white p-1.5 ring-1 ring-slate-200">
                      <img src={project.logo} alt={project.name} class="h-full w-full object-contain" />
                    </div>
                  ) : (
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-slate-blue/10 text-lg font-semibold text-slate-blue">
                      {getInitials(project.name)}
                    </div>
                  )
                }
                <div class="min-w-0">
                  <h3 class="font-semibold text-navy">{project.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">{project.title}</p>
                  <span class="mt-4 inline-flex items-center text-sm font-medium text-slate-blue">
                    {t.projects.viewProjectLabel}
                    <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 0 1 1.414 0l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1-1.414-1.414L14.586 11H3a1 1 0 1 1 0-2h11.586l-4.293-4.293a1 1 0 0 1 0-1.414Z" clip-rule="evenodd" />
                    </svg>
                  </span>
                </div>
              </Card>
            </a>
          ))
        }
      </div>
      <a
        href="https://github.com/Pineda-Lab"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-slate-blue hover:text-ice"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
        {t.projects.githubLinkText}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="max-w-2xl">
      <h2 class="text-balance text-3xl font-bold tracking-tight text-navy sm:text-4xl">{t.visit.heading}</h2>
      <p class="mt-3 text-slate-600">{t.visit.description}</p>
    </div>
    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <div class="overflow-hidden rounded-2xl border border-slate-200">
        <iframe
          title={t.visit.mapTitle}
          src={`https://www.google.com/maps?q=${mapsQuery}&output=embed`}
          class="h-72 w-full sm:h-full"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="flex h-72 flex-col justify-center gap-4 rounded-2xl border border-slate-200 bg-white p-6 sm:h-full sm:p-8">
        <img
          src="/images/logos/logo-enes-morelia.png"
          alt="ENES Morelia"
          width="360"
          height="222"
          class="h-14 w-auto self-start"
        />
        <div class="space-y-0.5 text-slate-700">
          {addressLines.map((line) => <p>{line}</p>)}
        </div>
        <div>
          <IconBadge href="https://www.enesmorelia.unam.mx" external>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
            ENES Morelia
          </IconBadge>
        </div>
      </div>
    </div>
  </section>
</Layout>
