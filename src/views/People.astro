---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import IconBadge from "../components/IconBadge.astro";
import Card from "../components/Card.astro";
import { getLocale, useTranslations } from "../i18n/utils";
import { getInitials } from "../utils/initials";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const email = "arturolp@enesmorelia.unam.mx";
const linkedin = "https://www.linkedin.com/in/arturo-lopez-pineda/";
const amphora = "https://amphora.health/";
const orcid = "https://orcid.org/0000-0002-3409-1815";
const scholar = "https://scholar.google.com/citations?user=qUYZhKEAAAAJ&hl=en&authuser=1";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: t.people.piName,
  jobTitle: t.people.piEyebrow,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Escuela Nacional de Estudios Superiores (ENES), Unidad Morelia, UNAM",
  },
  email: `mailto:${email}`,
  image: new URL("/images/people/arturo-headshot.png", Astro.site).toString(),
  url: Astro.url.toString(),
  sameAs: [linkedin, orcid, scholar, amphora],
};
---

<Layout title={t.people.title} description={t.people.description}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <PageHeader eyebrow={t.people.eyebrow} title={t.people.title} description={t.people.description} />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-10 rounded-3xl border border-slate-200 bg-white p-8 sm:p-10 lg:grid-cols-[220px_1fr]">
      <div class="flex flex-col items-center gap-4 lg:items-start">
        <div class="h-40 w-40 overflow-hidden rounded-2xl bg-slate-blue/10">
          <img
            src="/images/people/arturo-headshot.png"
            alt={t.people.piName}
            width="480"
            height="480"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <div>
        <Eyebrow>{t.people.piEyebrow}</Eyebrow>
        <h2 class="mt-1 text-2xl font-bold text-navy sm:text-3xl">{t.people.piName}</h2>
        <p class="mt-1 text-sm text-slate-500">{t.people.piAffiliation}</p>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate-600">{t.people.piBio}</p>
        <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">{t.people.piCeoNote}</p>

        <Eyebrow as="h3" class="mt-6">{t.people.educationHeading}</Eyebrow>
        <ul class="mt-3 max-w-3xl space-y-1.5">
          {
            t.people.education.map((degree) => (
              <li class="flex gap-2 text-sm leading-relaxed text-slate-600">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-slate-blue/40" />
                {degree}
              </li>
            ))
          }
        </ul>

        <div class="mt-6 space-y-4">
          <div>
            <Eyebrow as="h3" class="mb-2 text-xs">{t.people.contactLinksLabel}</Eyebrow>
            <div class="flex flex-wrap items-center gap-3">
              <IconBadge href={`mailto:${email}`}>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  />
                </svg>
                {email}
              </IconBadge>
            </div>
          </div>

          <div>
            <Eyebrow as="h3" class="mb-2 text-xs">{t.people.socialLinksLabel}</Eyebrow>
            <div class="flex flex-wrap items-center gap-3">
              <IconBadge href={linkedin} external>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <line x1="7.5" y1="10" x2="7.5" y2="16.5" />
                  <circle cx="7.5" cy="6.8" r="0.5" fill="currentColor" stroke="none" />
                  <path d="M12 16.5v-4a2.2 2.2 0 0 1 4.4 0v4" />
                  <line x1="12" y1="10" x2="12" y2="16.5" />
                </svg>
                {t.people.linkedinLabel}
              </IconBadge>
              <IconBadge href={orcid} external>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9.25" />
                  <line x1="8.2" y1="10" x2="8.2" y2="16" />
                  <circle cx="8.2" cy="7.3" r="0.5" fill="currentColor" stroke="none" />
                  <path d="M11.4 8.3h2.1a3.7 3.7 0 0 1 0 7.4h-2.1z" />
                </svg>
                {t.people.orcidLabel}
              </IconBadge>
              <IconBadge href={scholar} external>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4.26 10.147 7.44 3.998 7.44-3.998M4.26 10.147 2 9l9.7-5.25L21.4 9l-2.26 1.147m-14.88 0v5.406a2.25 2.25 0 0 0 1.183 1.981l6 3.231a2.25 2.25 0 0 0 2.134 0l6-3.231a2.25 2.25 0 0 0 1.183-1.98v-5.407" />
                </svg>
                {t.people.scholarLabel}
              </IconBadge>
            </div>
          </div>

          <div>
            <Eyebrow as="h3" class="mb-2 text-xs">{t.people.workLinksLabel}</Eyebrow>
            <div class="flex flex-wrap items-center gap-3">
              <IconBadge href={amphora} external>
                <svg class="h-4 w-auto shrink-0" viewBox="0 0 316 489" fill="currentColor" aria-hidden="true">
                  <g transform="translate(0,489) scale(0.1,-0.1)">
                    <path d="M1533 4689 c-24 -12 -52 -37 -65 -57 -23 -37 -23 -38 -26 -500 l-3
                    -463 -165 198 c-90 109 -179 206 -197 216 -24 14 -47 17 -91 14 -54 -3 -62 -7
                    -97 -44 -46 -49 -58 -100 -38 -156 9 -25 130 -179 329 -418 328 -394 353 -419
                    426 -419 71 0 102 31 425 420 171 206 316 386 321 400 14 36 4 117 -19 148
                    -10 15 -39 37 -64 50 -50 26 -104 24 -150 -6 -15 -9 -99 -104 -187 -210 l-161
                    -193 -3 463 -3 463 -24 39 c-26 42 -86 75 -136 76 -16 0 -49 -9 -72 -21z" />
                    <path d="M953 3270 c-418 -213 -714 -679 -794 -1250 -19 -139 -17 -478 4 -615
                    69 -439 234 -775 515 -1047 55 -53 132 -118 170 -143 l71 -45 684 0 684 0 59
                    38 c179 116 369 332 493 562 85 159 161 391 196 600 22 130 30 436 16 584 -51
                    523 -310 1002 -670 1240 -75 49 -224 126 -243 125 -13 0 -265 -299 -270 -319
                    -2 -6 41 -29 94 -50 292 -114 491 -339 607 -687 62 -186 75 -275 75 -533 1
                    -253 -8 -326 -59 -505 -33 -113 -117 -291 -187 -393 -29 -42 -92 -116 -140
                    -164 l-86 -88 -572 0 -571 0 -97 98 c-226 229 -345 530 -371 942 -20 312 26
                    574 144 815 133 272 316 441 575 530 36 13 64 28 62 34 -5 25 -258 320 -274
                    320 -9 1 -61 -21 -115 -49z" />
                    <path d="M1173 2435 c-100 -27 -218 -100 -254 -158 -42 -67 7 -157 86 -157 32
                    0 52 9 95 41 80 60 114 72 205 73 97 1 141 -18 236 -100 77 -67 161 -109 254
                    -129 88 -18 122 -18 210 0 93 20 181 64 244 123 46 43 51 52 51 90 0 32 -7 49
                    -29 74 -25 28 -36 33 -74 33 -35 0 -51 -6 -81 -32 -63 -56 -113 -76 -202 -81
                    -71 -4 -89 -1 -135 20 -30 14 -80 47 -111 75 -142 124 -329 172 -495 128z" />
                    <path d="M1181 1954 c-154 -41 -281 -138 -281 -214 0 -37 30 -81 66 -96 43
                    -18 79 -10 124 29 95 83 232 105 340 56 30 -14 82 -49 115 -79 184 -162 439
                    -182 644 -51 110 71 140 145 85 210 -45 54 -99 52 -169 -7 -57 -48 -124 -72
                    -201 -72 -97 0 -150 21 -230 91 -147 128 -330 177 -493 133z" />
                    <path d="M1171 1470 c-144 -38 -271 -136 -271 -210 0 -38 30 -81 67 -97 45
                    -18 75 -11 128 32 67 55 127 77 211 77 88 0 154 -27 229 -94 73 -65 106 -85
                    181 -114 181 -68 400 -25 534 104 44 42 50 53 50 89 0 49 -27 87 -74 103 -41
                    13 -73 2 -129 -45 -53 -45 -126 -70 -207 -69 -83 2 -135 24 -220 96 -88 75
                    -143 104 -235 128 -97 25 -168 25 -264 0z" />
                  </g>
                </svg>
                {t.people.amphoraLabel}
              </IconBadge>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <Eyebrow>{t.people.joinEyebrow}</Eyebrow>
    <h2 class="mt-1 text-2xl font-bold text-navy sm:text-3xl">{t.people.joinTitle}</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">{t.people.joinDescription}</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <Card>
        <h3 class="text-lg font-semibold text-navy">{t.people.joinEnesTitle}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{t.people.joinEnesDescription}</p>
        <div class="mt-4">
          <IconBadge href={`mailto:${email}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
              />
            </svg>
            {t.people.joinContactLabel}
          </IconBadge>
        </div>
      </Card>
      <Card>
        <h3 class="text-lg font-semibold text-navy">{t.people.joinOtherTitle}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{t.people.joinOtherDescription}</p>
        <div class="mt-4">
          <IconBadge href={`mailto:${email}`}>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
              />
            </svg>
            {t.people.joinContactLabel}
          </IconBadge>
        </div>
      </Card>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <Eyebrow>{t.people.alumniEyebrow}</Eyebrow>
    <h2 class="mt-1 text-2xl font-bold text-navy sm:text-3xl">{t.people.alumniTitle}</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">{t.people.alumniDescription}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        t.people.alumni.map((person) => (
          <Card class="flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-slate-blue/10 text-lg font-semibold text-slate-blue">
              {getInitials(person.name)}
            </div>
            <div class="min-w-0">
              <p class="font-semibold text-navy">{person.name}</p>
              <p class="text-sm text-slate-500">{person.degree}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-500">{person.institution}</p>
              <p class="mt-1 text-sm text-slate-600">{person.role}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </section>
</Layout>
